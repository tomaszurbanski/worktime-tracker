{
  "expo": {
    "name": "WorkTime Tracker",
    "slug": "worktime-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#2563EB",
    "privacyPolicyUrl": "https://tuautomation.de/privacy-worktimer.html",
    "description": "Track your work hours with one hold. GPS auto-starts when you arrive at work. Separate timers for business trips and commutes. Export PDF & CSV reports instantly.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turbanski.worktimetracker",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WorkTime Tracker uses your location to detect when you arrive at or leave your workplace and to log work sessions."
      }
    },
    "android": {
      "package": "com.turbanski.worktimetracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WorkTime Tracker uses your location to detect when you arrive at or leave your workplace and to log work sessions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "sounds": []
        }
      ],
      "expo-localization"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
